views {

  view index {
    title 'Landscape'
    description 'powsybl-network-analysis between powsybl-core and its users, and the future analyses it enables'
    include core, pypowsybl, na, stateEstimation, shortCircuit, reduction
  }

  view current of olf {
    title 'Current architecture'
    description 'Package groups of the single powsybl-open-loadflow module and their intended dependencies'
    include olf.*
    exclude * -> * where kind is violates
  }

  view currentViolations {
    title 'Dependencies blocking the split'
    description 'Only the dependencies from reusable package groups to load flow or security analysis code of this repository'
    include olf.network, olf.equations, olf.util, olf.providers, olf.sa, olf.engines
    exclude * -> * where kind is not violates
  }

  view target of na {
    title 'Target architecture'
    description 'Modules of powsybl-network-analysis. Dependencies only point towards the network model and commons.'
    include na.*
  }

  view targetReuse {
    title 'Reuse by future analyses'
    description 'Future analyses depend on the reusable modules, never on powsybl-open-loadflow'
    include na.commons, na.graph, na.network, na.equations
    exclude * -> * where kind is testScope
    include stateEstimation, shortCircuit, reduction
  }
}
